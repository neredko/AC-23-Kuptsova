#task 6. Слияние отсортированных списков

lst1 = [1,3,5]
lst2 = [2,4,6,7]

merged = []
i = 0  
j = 0  

while i < len(lst1) and j < len(lst2):
    if lst1[i] <= lst2[j]:
        merged.append(lst1[i])
        i += 1
    else:
        merged.append(lst2[j])
        j += 1

merged.extend(lst1[i:]) # остатки
merged.extend(lst2[j:])

print(merged) #[1,2,3,4,5,6,7]