#task 4. Сжатие списка

lst = [1,1,1,2,2,3,4,4,4,4,5]
compressed = []

i=0

while i < len(lst):
    current = lst[i]
    count=1

    while i + count < len(lst) and lst[i + count] == current:
        count += 1

    if count == 1: 
        compressed.append([current])
    else: 
        compressed.append([current,count])
        
    i += count

print(compressed) # [[1,3]],[2,2],3,[4,4],5]
