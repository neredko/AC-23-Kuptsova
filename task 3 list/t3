#task 3. Группировка по четности

nums = [1,4,7,2,9,8]
even_nums = []
odd_nums = []

for i in range(len(nums)):
    if nums[i] % 2 == 0: 
        even_nums.append(nums[i])
    else: 
        odd_nums.append(nums[i])

print(even_nums) # четные, [4,2,8]
print(odd_nums) # нечетные, [1,7,9]